# Скопируйте в .env и заполните своими значениями.
# .env находится в .gitignore и не попадает в репозиторий.

# Секретный ключ Django: сгенерируйте свой,
# например: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# False для продакшена, True только для локальной разработки
DJANGO_DEBUG=False

# Список доменов через запятую
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Ключи API (TMDB: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
OMDB_API_KEY=
KINOPOISK_API_KEY=
